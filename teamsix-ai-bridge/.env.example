# TEAMSIX public listener used by 9Router
TEAMSIX_HOST=127.0.0.1
TEAMSIX_PORT=11436

# Optional bearer key between 9Router and TEAMSIX
# TEAMSIX_API_KEY=change-me

# bridge = relay Codex/local tools through Responses function_call
# passthrough = preserve original tools for native Full MCP experiments
# off = disable tools
TEAMSIX_TOOLS_MODE=bridge

TEAMSIX_REQUEST_TIMEOUT_MS=600000
TEAMSIX_SESSION_TTL_MS=21600000
TEAMSIX_DASHBOARD=true

# Optional custom Plugin Hub file. Defaults to ./plugins.json for the development module.
# TEAMSIX_PLUGINS_FILE=C:\\TEAMSIX\\plugins.json

# DEVELOPMENT/DEBUG ONLY:
# The packaged TEAMSIX desktop application owns and starts its embedded ChatGPT Web runtime itself.
# Set this only when running the standalone development bridge against an explicitly started runtime.
# TEAMSIX_CHATGPT_WEB_URL=http://127.0.0.1:17841/v1
