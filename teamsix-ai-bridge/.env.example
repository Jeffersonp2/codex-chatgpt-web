# TEAMSIX listener used by 9Router
TEAMSIX_HOST=127.0.0.1
TEAMSIX_PORT=11436

# Optional bearer key between 9Router and TEAMSIX
# TEAMSIX_API_KEY=change-me

# Existing codex-chatgpt-web runtime
TEAMSIX_CHATGPT_WEB_URL=http://127.0.0.1:17841/v1

# bridge = ChatGPT requests Codex/local tools using TEAMSIX tool contract
# passthrough = preserve original tools for a native Full MCP setup
# off = disable tools
TEAMSIX_TOOLS_MODE=bridge

TEAMSIX_REQUEST_TIMEOUT_MS=600000
TEAMSIX_SESSION_TTL_MS=21600000
TEAMSIX_DASHBOARD=true

# Optional custom file. Defaults to ./plugins.json
# TEAMSIX_PLUGINS_FILE=C:\\TEAMSIX\\plugins.json
