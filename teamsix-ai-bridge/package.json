{
  "name": "teamsix-ai-bridge-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TEAMSIX 9Router bridge engine used by the packaged desktop application; standalone execution is for development only.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build:win": "bun build --compile --target=bun-windows-x64-baseline src/index.ts --outfile dist/teamsix-ai-bridge.exe"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
